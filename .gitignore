# Secrets — never commit credentials or environment files.
.env
.env.*

# Local kubeconfigs / cluster credentials (owned locally, mode 0600).
*.kubeconfig
huy-k3s.yaml
kubeconfig

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.coverage
.coverage
coverage/
coverage.out

# Node
node_modules/
npm-debug.log*

# Build output / transient artifacts
/bin/
/dist/
build/
*.log

# Generated browser bundle: produced by `npm run build` in web/ before every
# embed build (local, CI and Docker). web/ source and the lockfile are
# committed; this esbuild output is not, so go:embed always compiles against a
# freshly generated real bundle rather than a committed placeholder.
app/static/app.js

# Evidence captures are committed (screenshots, logs, JSON, Markdown).
# Re-include them after the transient *.log rule above.
!captures/**

# Editor / OS noise
.DS_Store
*.swp
*~
