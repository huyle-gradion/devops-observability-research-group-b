{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Stage 09 workload dashboard for the devops-app Service (namespace devops-app). Real request/error/latency from the app's own /metrics registry plus per-pod CPU/memory from kubelet/cAdvisor. Datasource is chosen at import via the ${datasource} variable; no foreign instance UID is hardcoded. Send success/error/delay traffic and wait for multiple 15s scrapes plus the 1m rate window before judging any panel.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Request rate over 1m for real GET /test traffic. Source: the app's own http_requests_total counter, scraped by Prometheus (ServiceMonitor interval 15s). Namespace devops-app. The rate window is 1m, so wait at least one full minute (multiple 15s scrapes) after sending traffic before this panel is meaningful.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"devops-app\",route=\"/test\"}[1m]))",
          "instant": false,
          "legendFormat": "GET /test req/s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request rate — GET /test (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraction (0-1, shown as a percentage) of real GET /test requests answered 4xx/5xx. Source: the app's own http_requests_total{status}, namespace devops-app, 1m window. Denominator is clamped to 0.001 so a quiet minute does not render as 0/0. Send failing traffic (?fail=1, or an invalid ?delay_ms) before judging this panel.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"devops-app\",route=\"/test\",status=~\"4..|5..\"}[1m])) / clamp_min(sum(rate(http_requests_total{namespace=\"devops-app\",route=\"/test\"}[1m])), 0.001)",
          "instant": false,
          "legendFormat": "error ratio (4xx+5xx / all)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error ratio — GET /test (percentunit)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "95th-percentile real GET /test latency in seconds, from the app's own http_request_duration_seconds histogram, namespace devops-app, 1m window. Send slow traffic (e.g. ?delay_ms=300) and wait the 1m rate window before comparing against the normal case.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"devops-app\",route=\"/test\"}[1m])))",
          "instant": false,
          "legendFormat": "p95 (s)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 latency — GET /test (s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Per-pod CPU cores for the app container (container=\"app\", image!=\"\" excludes the pause/POD cgroup), namespace devops-app, from kubelet/cAdvisor. Legend is keyed by pod. Note: a Service port-forward to devops-app reaches only one backing replica, so also target each pod directly (or drive both) to see real per-pod difference.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "cores"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"devops-app\",container=\"app\",image!=\"\"}[1m]))",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Per-pod CPU — app container (cores)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Per-pod memory working set bytes for the app container (container=\"app\", image!=\"\" excludes the pause/POD cgroup), namespace devops-app, from kubelet/cAdvisor. Legend is keyed by pod. This is the same pod set the CPU panel reads.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"devops-app\",container=\"app\",image!=\"\"})",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Per-pod memory — app container (bytes)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "huy",
    "stage-09",
    "devops-app"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "description": "Prometheus datasource for the huy-monitoring release. Chosen at import time; the panels reference this variable instead of a baked-in UID.",
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "devops-app workload (Stage 09 — huy)",
  "uid": "huy-workload",
  "version": 1,
  "weekStart": ""
}
